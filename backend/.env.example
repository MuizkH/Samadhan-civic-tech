# Copy this file to .env and fill in real values.  Never commit .env.
# All values below are obviously fake — replace every one before starting the app.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + PostGIS)
# For Neon: use the *pooled* URL for DATABASE_URL and the *unpooled/direct*
# URL (no "-pooler" in the hostname) for DIRECT_URL.
# prisma migrate deploy runs over DIRECT_URL; the app queries over DATABASE_URL.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://samadhan_user:FAKE_DB_PASSWORD@localhost:5432/samadhan_db?schema=public"
DIRECT_URL="postgresql://samadhan_user:FAKE_DB_PASSWORD@localhost:5432/samadhan_db?schema=public"

# ---------------------------------------------------------------------------
# JWT signing secrets
# Generate with: openssl rand -hex 32
# Keep ACCESS and REFRESH secrets different from each other.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=<generate: openssl rand -hex 32>
JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------------------------------------------------------------------------
# Cloudinary (signed uploads)
# Create a free account at https://cloudinary.com, then find these values
# in Dashboard → API Keys.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=my-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=<from cloudinary dashboard>

# ---------------------------------------------------------------------------
# Seed script credentials — used by `npm run seed` only, not by the API.
# These set the initial passwords for seeded accounts.
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=superadmin@example-samadhan.gov.in
SEED_SUPER_ADMIN_PASSWORD=<choose a strong seed password>

# Department admin credentials — one pair per department
SEED_WATER_SUPPLY_ADMIN_EMAIL=water-supply.admin@example-samadhan.gov.in
SEED_WATER_SUPPLY_ADMIN_PASSWORD=<choose a strong seed password>

SEED_SANITATION_ADMIN_EMAIL=sanitation.admin@example-samadhan.gov.in
SEED_SANITATION_ADMIN_PASSWORD=<choose a strong seed password>

SEED_ELECTRICITY_ADMIN_EMAIL=electricity.admin@example-samadhan.gov.in
SEED_ELECTRICITY_ADMIN_PASSWORD=<choose a strong seed password>

SEED_ROADS_ADMIN_EMAIL=roads.admin@example-samadhan.gov.in
SEED_ROADS_ADMIN_PASSWORD=<choose a strong seed password>

SEED_PARKS_ADMIN_EMAIL=parks.admin@example-samadhan.gov.in
SEED_PARKS_ADMIN_PASSWORD=<choose a strong seed password>

SEED_BUILDINGS_ADMIN_EMAIL=buildings.admin@example-samadhan.gov.in
SEED_BUILDINGS_ADMIN_PASSWORD=<choose a strong seed password>

SEED_METRO_ADMIN_EMAIL=metro.admin@example-samadhan.gov.in
SEED_METRO_ADMIN_PASSWORD=<choose a strong seed password>

# Password applied to all seeded citizen accounts
SEED_CITIZEN_PASSWORD=<choose a strong seed password>

# ---------------------------------------------------------------------------
# Server
# CORS_ORIGIN: comma-separated list of exact frontend origins (no wildcards).
# In production this MUST be set or the server will refuse to start.
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------------------
# Test database — used by `npm test` only, never by the running API.
# Must differ from DATABASE_URL; tests refuse to run if they match.
# ---------------------------------------------------------------------------
TEST_DATABASE_URL="postgresql://samadhan_user:FAKE_DB_PASSWORD@localhost:5432/samadhan_test_db?schema=public"

# ---------------------------------------------------------------------------
# AI providers (both optional — omit or leave blank to disable AI features)
# GROQ: https://console.groq.com/keys
# Gemini: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------------
# Email delivery via Resend (https://resend.com/api-keys)
# Without a key, notifications are marked failed with a logged reason instead
# of being silently dropped.
# NOTIFICATION_FROM_EMAIL: must use a domain you have verified in Resend.
# DEV_EMAIL_OVERRIDE: redirect all outbound mail to this address in non-prod
# (seeded users are on @example-samadhan.gov.in which Resend will reject).
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NOTIFICATION_FROM_EMAIL="Samadhan <noreply@your-verified-domain.example.com>"
DEV_EMAIL_OVERRIDE=your-real-test-inbox@example.com
