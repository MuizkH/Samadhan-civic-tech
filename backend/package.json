    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@prisma/client": "^5.20.0",
    "@types/multer": "^2.2.0",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "groq-sdk": "^1.5.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "pg-boss": "^12.27.0",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "resend": "^6.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.16.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.8.1",
